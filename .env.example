# Copy to .env and fill values. FlipCheck loads .env automatically; shell variables win.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
# Optional: enables the live eBay Australia scanner.
SERPAPI_KEY=
# Optional: Facebook Marketplace via Apify (separate provider account/credit).
# Uses memo23/facebook-marketplace-scraper-ppe; no Facebook cookies needed.
APIFY_TOKEN=
# FLIPCHECK_DATA_DIR=.data
# FLIPCHECK_PORT=8765
