{
  "name": "flipcheck",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @flipcheck/web",
    "build": "npm run build --workspace @flipcheck/web",
    "start": "node scripts/dev.mjs --production",
    "typecheck": "npm run typecheck --workspace @flipcheck/web",
    "test": "python3 -m unittest discover -s tests -v",
    "test:browser": "node scripts/browser-smoke.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "playwright": "1.64.1"
  }
}
